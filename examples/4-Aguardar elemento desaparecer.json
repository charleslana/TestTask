{
  "name": "Exemplo Aguardar elemento desaparecer",
  "version": "1.0.0",
  "testType": "e2e",
  "test": {
    "url": "https://practice.expandtesting.com/dynamic-loading/1",
    "actions": [
      {
        "type": "click",
        "selector": "//button[contains(@class, \"btn-primary\")]",
        "text": "",
        "disabled": false
      },
      {
        "type": "waitForVisible",
        "selector": "#loading",
        "text": "",
        "disabled": false
      },
      {
        "type": "waitForNotVisible",
        "selector": "#loading",
        "text": "",
        "disabled": false
      }
    ]
  }
}